# Local test pipeline for the alors project itself.
# Imported by the root tasks.alors as `ci`. The root defines the bare `ci` task,
# so `alors ci` runs the pipeline; `alors ci test`, `alors ci build`, ... run these.

# run the unit + integration test suite
test:
    cargo test --locked

# build the optimized binary (also the gate the release artifact comes from)
build:
    cargo build --release --locked

# Note: the pipeline entry point is the bare `ci` task in the ROOT tasks.alors
# (`ci: ci::test ci::build`), so `alors ci` runs test-then-build. It can't live
# here — every task in this imported file is prefixed `ci::`, so this file
# cannot define a bare `ci`.

# --- advisory checks (the tree is hand-styled, so these currently fail) ---

# check formatting without rewriting anything
fmt:
    cargo fmt --all -- --check

# clippy lints, warnings treated as errors
lint:
    cargo clippy --locked --all-targets -- -D warnings
