import "alors/help.alors"

import "alors/help2.alors" as help2

# the project's own local test pipeline: `alors ci test`, `alors ci build`, ...
import "alors/ci.alors" as ci

# `alors ci` runs the whole pipeline (test, then release build); `alors ci test`
# and friends still work as subcommands. This bare `ci` task lives in the root
# because everything in the imported alors/ci.alors is prefixed `ci::`.
ci: ci::test, ci::build

# configure the CMake build tree
configure:
    echo "[configure] cmake -S . -B build"

# compile what's already configured
compile:
    echo "[compile] cmake --build build"

# the everyday task: configure, then compile (deps run first, in order)
build: configure, compile

# build is also a namespace: `alors build release` for an optimized build
build::release:
    echo "[build::release] cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build"

# a task with a parameter
test name:
    echo "[test] ctest --test-dir build -R {{name}}"

# a sequence that passes a fixed argument to a task: `alors smoke` runs `test`
# with name=smoke first (comma-separated deps can carry positional args)
smoke: test smoke
    echo "[smoke] done"

# wipe the whole build tree
clean:
    echo "[clean] rm -rf build"

# build the optimized binary and install it as /usr/local/bin/alors
install:
    cargo build --release
    dest=/usr/local/bin/alors
    if cp target/release/alors "$dest" 2>/dev/null; then
        echo "installed -> $dest"
    else
        echo "writing $dest needs elevated permissions..."
        sudo install -m 755 target/release/alors "$dest" && echo "installed -> $dest"
    fi

# cut a release: tag the version in Cargo.toml and push it — GitHub Actions
# builds the binaries and opens the release for the tag. Bump the version and
# commit it first; this task only ships what's already committed.
publish: ci
    version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
    tag="v$version"

    if [ -n "$(git status --porcelain)" ]; then
        echo "[publish] working tree is dirty — commit before releasing"
        exit 1
    fi
    if [ "$(git rev-parse --abbrev-ref HEAD)" != "main" ]; then
        echo "[publish] not on main — releases are cut from main"
        exit 1
    fi
    if git rev-parse --quiet --verify "refs/tags/$tag" > /dev/null; then
        echo "[publish] $tag already exists — bump the version in Cargo.toml first"
        exit 1
    fi

    echo "[publish] releasing $tag"
    git tag "$tag"
    git push origin main
    git push origin "$tag"

    echo "[publish] pushed — Actions is building the binaries:"
    echo "  https://github.com/Wenke-D/alors/actions"
    echo "[publish] once it's green, add the highlights on top of the auto notes:"
    echo "  https://github.com/Wenke-D/alors/releases/tag/$tag"
