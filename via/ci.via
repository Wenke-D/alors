# Local test pipeline for the via project itself.
# Imported by the root viafile as `ci`. The root defines the bare `ci` task,
# so `via ci` runs the pipeline; `via ci test`, `via ci build`, ... run these.

# run the unit + integration test suite
test:
    cargo test --locked

# build the optimized binary (also the gate the release artifact comes from)
build:
    cargo build --release --locked

# Note: the pipeline entry point is the bare `ci` task in the ROOT viafile
# (`ci: ci::test ci::build`), so `via ci` runs test-then-build. It can't live
# here — every task in this imported file is prefixed `ci::`, so this file
# cannot define a bare `ci`.

# --- advisory checks (the tree is hand-styled, so these currently fail) ---

# check formatting without rewriting anything
fmt:
    cargo fmt --all -- --check

# clippy lints, warnings treated as errors
lint:
    cargo clippy --locked --all-targets -- -D warnings
