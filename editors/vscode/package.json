{
  "name": "alors",
  "displayName": "alors — tasks file for the alors CLI",
  "description": "Syntax highlighting for .alors files — the tasks files for alors, a CLI for your project.",
  "version": "0.1.0",
  "publisher": "wenke",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "alors",
    "tasks.alors",
    "cli",
    "syntax highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Wenke-D/alors.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/Wenke-D/alors/tree/main/editors/vscode",
  "bugs": {
    "url": "https://github.com/Wenke-D/alors/issues"
  },
  "contributes": {
    "languages": [
      {
        "id": "alors",
        "aliases": [
          "alors",
          "Alors"
        ],
        "extensions": [
          ".alors"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "alors",
        "scopeName": "source.alors",
        "path": "./syntaxes/alors.tmLanguage.json"
      }
    ]
  }
}
