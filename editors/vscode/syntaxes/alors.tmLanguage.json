{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "alors",
  "scopeName": "source.alors",
  "patterns": [
    { "include": "#comment" },
    { "include": "#import-directive" },
    { "include": "#task-header" },
    { "include": "#interpolation" },
    { "include": "#variable" }
  ],
  "repository": {
    "comment": {
      "comment": "A full-line comment (only at column 0, per the alors grammar).",
      "match": "^#.*$",
      "name": "comment.line.number-sign.alors"
    },
    "import-directive": {
      "comment": "import \"path\" [as namespace]  at column 0.",
      "match": "^(import)[ \\t]+(\"[^\"]*\")(?:[ \\t]+(as)[ \\t]+([A-Za-z0-9_-]+(?:::[A-Za-z0-9_-]+)*))?[ \\t]*$",
      "captures": {
        "1": { "name": "keyword.control.import.alors" },
        "2": { "name": "string.quoted.double.alors" },
        "3": { "name": "keyword.control.import.alors" },
        "4": {
          "name": "entity.name.namespace.alors",
          "patterns": [
            { "match": "::", "name": "punctuation.separator.namespace.alors" }
          ]
        }
      }
    },
    "task-header": {
      "comment": "NAME [params...] : [deps...]  at column 0.",
      "match": "^([A-Za-z0-9_-]+(?:::[A-Za-z0-9_-]+)*)((?:[ \\t]+[A-Za-z0-9_]+)*)[ \\t]*(:)(.*)$",
      "captures": {
        "1": {
          "name": "entity.name.function.task.alors",
          "patterns": [
            { "match": "::", "name": "punctuation.separator.namespace.alors" }
          ]
        },
        "2": {
          "patterns": [
            { "match": "[A-Za-z0-9_]+", "name": "variable.parameter.alors" }
          ]
        },
        "3": { "name": "punctuation.separator.task.alors" },
        "4": {
          "patterns": [
            { "match": "::", "name": "punctuation.separator.namespace.alors" },
            { "match": "[A-Za-z0-9_-]+", "name": "entity.name.function.dependency.alors" }
          ]
        }
      }
    },
    "interpolation": {
      "comment": "{{ name }} parameter substitution in a task body.",
      "match": "(\\{\\{)[ \\t]*([A-Za-z0-9_]+)[ \\t]*(\\}\\})",
      "captures": {
        "1": { "name": "punctuation.section.interpolation.begin.alors" },
        "2": { "name": "variable.other.interpolation.alors" },
        "3": { "name": "punctuation.section.interpolation.end.alors" }
      }
    },
    "variable": {
      "comment": "Shell-style $name / ${name} references in a task body.",
      "match": "(\\$)(\\{)?([A-Za-z_][A-Za-z0-9_]*)(\\})?",
      "name": "variable.other.alors"
    }
  }
}
