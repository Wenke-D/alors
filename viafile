import "via/help.via"

import "via/help2.via" as help2

# the project's own local test pipeline: `via ci test`, `via ci build`, ...
import "via/ci.via" as ci

# `via ci` runs the whole pipeline (test, then release build); `via ci test` and
# friends still work as subcommands. This bare `ci` task lives in the root
# because everything in the imported via/ci.via is prefixed `ci::`.
ci: ci::test, ci::build

# configure the CMake build tree
configure:
    echo "[configure] cmake -S . -B build"

# compile what's already configured
compile:
    echo "[compile] cmake --build build"

# the everyday task: configure, then compile (deps run first, in order)
build: configure, compile

# build is also a namespace: `via build release` for an optimized build
build::release:
    echo "[build::release] cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build"

# a task with a parameter
test name:
    echo "[test] ctest --test-dir build -R {{name}}"

# a sequence that passes a fixed argument to a task: `via smoke` runs `test`
# with name=smoke first (comma-separated deps can carry positional args)
smoke: test smoke
    echo "[smoke] done"

# wipe the whole build tree
clean:
    echo "[clean] rm -rf build"

# build the optimized binary and install it as /usr/local/bin/via
install:
    cargo build --release
    dest=/usr/local/bin/via
    if cp target/release/via "$dest" 2>/dev/null; then
        echo "installed -> $dest"
    else
        echo "writing $dest needs elevated permissions..."
        sudo install -m 755 target/release/via "$dest" && echo "installed -> $dest"
    fi
